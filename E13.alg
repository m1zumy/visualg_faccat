algoritmo "E13"

var
   numero1, numero2, numero3: real

inicio

   escreva("Coloque o primeiro valor: ")
   leia(numero1)

   escreva("Coloque o segundo valor: ")
   leia(numero2)

   escreva("Coloque o terceiro valor: ")
   leia(numero3)

   escreval("A media final é: ", ((numero1 * 2) + (numero2 * 3) + (numero3 * 5)) / 10)

fimalgoritmo

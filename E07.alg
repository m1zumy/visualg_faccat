algoritmo "E07"

var
   anos, meses, dias: inteiro

inicio

   escreva("Quantos anos você tem? ")
   leia(anos)

   escreva("Quantos meses você tem? ")
   leia(meses)

   escreva("Quantos dias você tem? ")
   leia(dias)

   escreval("Seu tempo de vida na terra é: ", (anos * 365) + (meses * 30) + dias)

fimalgoritmo
